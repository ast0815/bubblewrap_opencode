#!/usr/bin/env bash
#
# sandbox-selftest — runs INSIDE the bubblewrap sandbox and reports [ OK ],
# [CLOSED] or [ OPEN ]. Host IPC is tested with a bare connect(2): client error
# messages that look like failures often mean the socket was reached.
#
# Usage: ./sandbox-selftest [all|security|functional|toolchains]
# Env:   SBX_EGRESS_URL, SBX_DNS_HOST pin the network probes.

set -uo pipefail

WHICH="${1:-all}"
RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; BOLD=$'\033[1m'; DIM=$'\033[2m'; OFF=$'\033[0m'
fails=0

ok()     { printf '  %s[ OK ]%s   %s\n' "$GREEN" "$OFF" "$1"; }
closed() { printf '  %s[CLOSED] %s  %s\n' "$GREEN" "$OFF" "$1"; }
open_()  { printf '  %s[ OPEN] %s  %s\n' "$RED" "$OFF" "$1"; printf '         %s↳ reachable%s\n' "$DIM" "$OFF"; fails=$((fails+1)); }
bad()    { printf '  %s[FAIL ] %s  %s\n' "$RED" "$OFF" "$1"; fails=$((fails+1)); }
note()   { [ -n "$1" ] && printf '         %s%s%s\n' "$DIM" "$1" "$OFF"; return 0; }
section(){ printf '\n%s%s%s\n' "$BOLD" "$1" "$OFF"; }

# try_connect <path> -> 0 if a client can connect (i.e. the door is open)
try_connect() {
    python3 - "$1" <<'PY' 2>/dev/null
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(3)
try:
    s.connect(sys.argv[1])
except Exception:
    sys.exit(1)
sys.exit(0)
PY
}

# sock <label> <path...>  — closed unless one of the paths accepts a connection
declare -A seen=()
sock() {
    local label=$1; shift
    local p hit=""
    for p in "$@"; do
        [ -S "$p" ] || continue
        seen["$p"]=1          # register every candidate, not just up to the first hit
    done
    for p in "$@"; do
        [ -S "$p" ] || continue
        if try_connect "$p"; then hit="$p"; break; fi
    done
    if [ -n "$hit" ]; then open_ "$label  →  $hit"; else closed "$label"; fi
}

# run <label> <success-pattern|-> <cmd...>  — open only if the dangerous thing happened
run() {
    local label=$1 pat=$2; shift 2
    local out rc
    out=$(timeout 20 "$@" 2>&1); rc=$?
    if [ "$pat" = "-" ]; then
        if [ $rc -eq 0 ]; then ok "$label"; else bad "$label  (exit $rc)"; note "$(printf '%s' "$out" | head -1)"; fi
    elif printf '%s' "$out" | grep -qE "$pat"; then
        open_ "$label"; note "$(printf '%s' "$out" | grep -m1 -E "$pat")"
    else
        closed "$label"; note "$(printf '%s' "$out" | head -1)"
    fi
}

# bind_root <path> — the source subtree behind <path>, or empty if <path> is
# not its own mount point. This is how writable paths are classified: a path
# comparison cannot tell a per-repo bind from a shared one.
#
# Field 5 of mountinfo is the mount point, field 4 the source root. The root is
# filesystem-relative (`/@home/...` on btrfs), so callers match on a suffix or
# the repo key, never a full host path.
bind_root() {
    awk -v want="$1" '
        $5 == want || $5 == want "/" { print $4; found = 1; exit }
        END { exit(found ? 0 : 1) }
    ' /proc/self/mountinfo 2>/dev/null
}

# denied <label> <cmd...> — for things that must NOT work. Success is the finding.
denied() {
    local label=$1; shift
    local out rc
    out=$(timeout 20 "$@" 2>&1); rc=$?
    if [ $rc -eq 0 ]; then
        open_ "$label"
        note "$(printf '%s' "$out" | head -1)"
    else
        closed "$label"
        note "$(printf '%s' "$out" | grep -m1 -iE 'not permitted|denied|read-only|ENOSPC|No space|failed|not found' || printf '%s' "$out" | head -1)"
    fi
}

# cwd_is_home_or_above — 0 when the working directory is $HOME or a parent of it.
# The wrapper mounts that case read-only unless OPENCODE_SANDBOX_HOME_RW=1, so
# the expectations below are derived from the same condition.
cwd_is_home_or_above() {
    local cwd home
    cwd="$(pwd -P)"
    home="$(readlink -f -- "$HOME" 2>/dev/null || printf '%s' "$HOME")"
    case "${home}/" in "${cwd%/}/"*) return 0 ;; esac
    return 1
}

# The per-repo root: XDG_DATA_HOME is $SBX/data. One dirname, not two; the
# grandparent is the shared base, which is not what the repo-key check wants.
SBX_ROOT="$(dirname "${XDG_DATA_HOME:-/nonexistent/data}")"
# The key is the directory name the wrapper derives from the repo path. It is
# what distinguishes "this repo's own bind" from "a directory shared with other
# repos" in a mount root, robustly across filesystems -- see below.
SBX_KEY="$(basename "${SBX_ROOT}")"
# The base that holds this repo's directory and shared/. Used only to check the
# shared state root is masked at its own path; it is not a repo key.
SBX_PARENT="$(dirname "${SBX_ROOT}")"
SHARED_STATE="${SBX_PARENT}/shared/state/opencode"
SHARED_CONFIG="${SBX_PARENT}/shared/config/opencode"

# Inside the sandbox or on the host? UV_TOOL_BIN_DIR under the wrapper's state
# root is only ever true inside. XDG_DATA_HOME is set by a desktop session too,
# so it is the wrong signal.
IN_SANDBOX=0
if [ -n "${UV_TOOL_BIN_DIR:-}" ] && [ -n "${XDG_DATA_HOME:-}" ]; then
    case "$UV_TOOL_BIN_DIR" in
        "$SBX_ROOT"/*) IN_SANDBOX=1 ;;
    esac
fi

# Expand every wrapper-provided variable with a default: the script runs under
# `set -u`, and a missing one would abort instead of reporting a finding.

if [ "$IN_SANDBOX" -eq 0 ]; then
    # Heading at column 0 and a parenthetical, the way the section headers are
    # written; then one aligned row per section saying what it is expected to
    # report here. Outcomes are spelled out as words instead of reusing the
    # report's own [ OK ]/FAIL colouring, because an expected result wearing the
    # same colours as a real finding is how a host run reads as a broken sandbox.
    printf '\n%sNOT INSIDE A SANDBOX%s  %s(this is the host, not a sandbox)%s\n' \
        "$BOLD" "$OFF" "$DIM" "$OFF"
    while IFS='|' read -r label outcome why; do
        printf '    %-28s %-8s %s%s%s\n' "$label" "$outcome" "$DIM" "$why" "$OFF"
    done <<'EOF'
FUNCTIONALITY|pass|a host baseline, and nothing more
OPENCODE CONFIG|fail|the sandbox config exists only inside
PREFERENCES|[ n/a ]|shared state exists only inside
CROSS-REPO ISOLATION|[ OPEN ]|nothing is masked on a host
HOST IPC, ESCAPE MECHANISMS|[ OPEN ]|a host really does have both
EOF
    printf '\n  %sOnly a session started by bubblewrap_opencode can say anything about the sandbox.%s\n' \
        "$DIM" "$OFF"
fi

# ---------------------------------------------------------------- functional
if [ "$WHICH" = all ] || [ "$WHICH" = functional ]; then
    section "FUNCTIONALITY (must keep working)"
    run "opencode runs"                 - opencode --version
    run "node"                          - node --version
    run "bun"                           - bun --version
    run "git"                           - git --version
    run "python3"                       - python3 --version
    run "ssh"                           - ssh -V
    # A real authenticated call, because that is what the env token is for. A
    # plain run without the flag is the off state: skip, never FAIL.
    if [ -n "${GH_TOKEN:-}" ]; then
        if command -v gh >/dev/null 2>&1; then
            run "github token authenticates"    - gh api user -q .login
        else
            printf '  %s[ n/a ]%s  github token: gh not installed\n' "$DIM" "$OFF"
        fi
    else
        printf '  %s[skip]%s  github token (GH_TOKEN unset; run the wrapper with OPENCODE_SANDBOX_GH_TOKEN=1)\n' "$DIM" "$OFF"
    fi
    if cwd_is_home_or_above && [ "${OPENCODE_SANDBOX_HOME_RW:-0}" != 1 ]; then
        printf '  %s[ n/a ]%s  working dir is HOME or above it: read-only (see WORKING DIRECTORY AND HOME)\n' "$DIM" "$OFF"
    else
        run "working dir is writable"   - touch ./.selftest-probe
    fi
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        run "git history readable"      - git log --oneline -1
    else
        printf '  %s[ n/a ]%s  git history: working dir is not a git repository\n' "$DIM" "$OFF"
    fi
    run "filesystem is readable"        - ls /usr/bin
    run "HOME is readable"              - ls "$HOME"
    run "user lookup works (nsswitch)"  - getent passwd "$(id -un)"
    run "DNS resolution works"          - getent hosts "${SBX_DNS_HOST:-localhost}"
    # Egress: any HTTP response counts, including 401/404 -- what is asserted is
    # that the connection is made, not that it is authorised. There is no single
    # hard-coded target because the IANA example domains are unreachable on some
    # networks, so a short candidate list is tried and whichever answers is
    # named. Set SBX_EGRESS_URL to check one specific endpoint instead.
    if [ -n "${SBX_EGRESS_URL:-}" ]; then
        run "egress to the internet"    - curl -sS -o /dev/null --max-time 10 "${SBX_EGRESS_URL}"
    else
        egress=""
        for u in https://api.anthropic.com https://registry.npmjs.org \
                 https://pypi.org https://example.com; do
            if curl -sS -o /dev/null --max-time 8 "$u" 2>/dev/null; then egress="$u"; break; fi
        done
        if [ -n "$egress" ]; then
            ok "egress to the internet  (reached $egress)"
        else
            bad "egress to the internet"
            note "no candidate endpoint answered; set SBX_EGRESS_URL to your provider"
        fi
    fi
    run "/tmp is writable"              - touch /tmp/.selftest-probe
    rm -f ./.selftest-probe /tmp/.selftest-probe 2>/dev/null

    printf '\n  %sbounds that are writable from inside%s\n' "$BOLD" "$OFF"
    # A writable tmpfs is expected (discarded on exit); the finding is a write
    # that lands on a host filesystem. $XDG_CACHE_HOME is the per-repo copy;
    # ~/.cache/opencode is the host original and must be read-only. The state
    # directory *looks* repo-local but is a bind of the shared root; bind_root
    # tells them apart.
    for d in "$HOME/.bun" "$HOME/.local/share/uv/tools" "$HOME/.local/state/opencode" \
             "$HOME/.local/share/opencode" "$HOME/.cache" "$HOME/.cache/opencode" \
             "$HOME/.config/opencode" "$HOME/.config/opencode/cli.json" \
             "${XDG_CACHE_HOME:-/nonexistent}" "${XDG_CACHE_HOME:-/nonexistent}/opencode" \
             "$HOME/.ssh" \
             "${XDG_CONFIG_HOME:-$HOME/.config}" "${OPENCODE_CONFIG_DIR:-/nonexistent}" \
             "${XDG_STATE_HOME:-/nonexistent}/opencode"; do
        [ -e "$d" ] || continue
        # cli.json is a file, so there is no ".selftest-probe" to create inside
        # it. test -w answers the same question for a file and has the advantage
        # of not modifying the file it inspects.
        if [ -f "$d" ]; then
            [ -w "$d" ] || { printf '    %sro        %s  %s\n' "$GREEN" "$OFF" "$d"; continue; }
        elif ! touch "$d/.selftest-probe" 2>/dev/null; then
            printf '    %sro        %s  %s\n' "$GREEN" "$OFF" "$d"
            continue
        else
            rm -f "$d/.selftest-probe" 2>/dev/null
        fi
        case "$(stat -f -c %T "$d" 2>/dev/null)" in
            tmpfs) printf '    %stmpfs      %s  (writable, but empty and ephemeral)%s\n' "$YELLOW" "$d" "$OFF" ;;
            *)
                # bind_root gives the host source; an empty root is a plain file
                # in an ordinary writable bind. Compare on the repo key, not a
                # full prefix: mountinfo roots are filesystem-relative
                # (`/@home/...` on btrfs), and the key is absent from shared roots.
                root="$(bind_root "$d")"
                if [ -z "$root" ] || [ "${root#*"$SBX_KEY"}" != "$root" ]; then
                    # Either genuinely this repo's own storage, or a plain file in
                    # it. Both are the design.
                    printf '    %srepo-local %s  (this repo'"'"'s own state dir)%s\n' "$YELLOW" "$d" "$OFF"
                else
                    # A bind whose source lives outside this repo's directory.
                    # Named, not coloured red: this is the shared state or config
                    # doing what it is for, and naming the source is the point.
                    printf '    %sshared     %s  (bind of %s)%s\n' "$YELLOW" "$d" "$root" "$OFF"
                fi
                ;;
        esac
    done
    [ -n "${SSH_AUTH_SOCK:-}" ] && printf '    SSH_AUTH_SOCK=%s\n' "$SSH_AUTH_SOCK"

    # --- opencode config ------------------------------------------------------
    # The host config is read-only; the sandbox uses the shared seeded copy.
    section "OPENCODE CONFIG (shared by every repo, seeded from the host)"
    if [ -z "${OPENCODE_CONFIG_DIR:-}" ]; then
        bad "OPENCODE_CONFIG_DIR is not set"
    else
        ok "OPENCODE_CONFIG_DIR=${OPENCODE_CONFIG_DIR}"
        run "config dir is writable" - touch "${OPENCODE_CONFIG_DIR}/.selftest-probe"
        rm -f "${OPENCODE_CONFIG_DIR}/.selftest-probe" 2>/dev/null
        # The bind has to be the shared sandbox copy, not the host's directory
        # wearing the same variable. Inodes differ because it is a copy; the
        # mount table says whether it is the shared copy or a per-repo one.
        croot="$(bind_root "${OPENCODE_CONFIG_DIR}")"
        case "$croot" in
            */shared/config/opencode)
                ok "config dir is the shared sandbox copy"
                ;;
            "")
                bad "config dir is not a bind of the shared sandbox copy"
                note "a per-repo or host directory here would make config changes repo-local"
                ;;
            *)
                bad "config dir is bound from an unexpected source"
                note "$croot"
                ;;
        esac
        if [ -e "${OPENCODE_CONFIG_DIR}/cli.json" ]; then
            host_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/cli.json"
            if [ "$(stat -c %d:%i "${OPENCODE_CONFIG_DIR}/cli.json" 2>/dev/null)" = \
                 "$(stat -c %d:%i "$host_cfg" 2>/dev/null)" ]; then
                bad "config/cli.json is the host's own file, not the sandbox copy"
                note "a writable host config is a config change an agent can plant for every later session"
            else
                ok "cli.json is the sandbox copy, not the host's file"
            fi
        else
            note "no cli.json in the copy (the host has none, or the seed failed)"
        fi
        # The host config can carry a service.json with the host-wide server
        # password. The wrapper masks the host path and strips the copy, so it
        # must not be here; a copy would hand the sandbox a localhost password.
        if [ -e "${OPENCODE_CONFIG_DIR}/service.json" ]; then
            bad "the config copy contains service.json (the host service password)"
            note "remove it from ${OPENCODE_CONFIG_DIR}; it is host state, not configuration"
        else
            ok "no service.json in the config copy"
        fi
        # A dangling symlink in the copy is the failure mode that costs the user
        # an afternoon: opencode starts, has no providers and no MCP servers, and
        # says nothing about why. This is the check that catches it.
        dangling="$(find "${OPENCODE_CONFIG_DIR}" -xtype l -print 2>/dev/null | head -5)"
        if [ -n "$dangling" ]; then
            bad "dangling symlinks in the config copy"
            printf '%s\n' "$dangling" | while IFS= read -r l; do note "↳ $l"; done
        else
            ok "no dangling symlinks in the config copy"
        fi
        # The host's copy must be read-only; that is the invariant the shared
        # arrangement exists to preserve. Checked in the security section.
    fi

    # --- shared opencode state ------------------------------------------------
    section "PREFERENCES (shared by every repo, not the host)"
    prefs="${XDG_STATE_HOME:-/nonexistent}/opencode/model.json"
    if [ "$IN_SANDBOX" -eq 0 ]; then
        printf '  %s[ n/a ]%s  shared state exists only inside the sandbox\n' "$DIM" "$OFF"
    elif [ ! -e "$prefs" ]; then
        bad "no model.json at ${prefs}"
    else
        ok "model.json present at ${prefs}"
        # The directory is opencode's state path by construction; bind_root says
        # whether it is the shared copy. Match on a suffix: mountinfo roots are
        # filesystem-relative (`/@home/...` on btrfs).
        state_dir="$(dirname "$prefs")"
        sroot="$(bind_root "$state_dir")"
        case "$sroot" in
            */shared/state/opencode)
                ok "opencode state is shared by every repo"
                ;;
            "")
                if [ "$IN_SANDBOX" -eq 1 ]; then
                    bad "the state directory is not a bind of the shared state"
                    note "favourites and the rest of opencode's state stay per repo"
                else
                    printf '  %s[ n/a ]%s  shared state exists only inside the sandbox\n' "$DIM" "$OFF"
                fi
                ;;
            *)
                bad "the state directory is bound from an unexpected source"
                note "$sroot"
                ;;
        esac
        if [ "$IN_SANDBOX" -eq 1 ]; then
            # The bind is at the sandbox's state path, not at the shared
            # directory's own path; the latter sits inside the masked state root.
            if [ -e "${SBX_PARENT}/shared" ]; then
                bad "the shared state root is visible at its own path"
                note "${SBX_PARENT}/shared"
            else
                ok "the shared state root is masked at its own path"
            fi
            # The write that used to fail: opencode writes model.json with
            # write(tmp)+rename(path); a single-file bind made that EBUSY.
            # Do the same operation, then restore the file.
            if cp -p -- "$prefs" "${prefs}.selftest-backup.$$" 2>/dev/null; then
                prefs_backup="${prefs}.selftest-backup.$$"
                prefs_restore_failed=0
                prefs_restore() {
                    [ -n "${prefs_backup:-}" ] && [ -f "$prefs_backup" ] &&
                        { cp -p -- "$prefs_backup" "$prefs" 2>/dev/null || prefs_restore_failed=1; }
                    rm -f -- "${prefs_backup:-}" "${prefs}.selftest-new.$$" 2>/dev/null
                    prefs_backup=""
                }
                trap 'prefs_restore' EXIT INT TERM HUP
                if printf '%s\n' '{"recent":[],"favorite":["selftest"],"variant":{}}' \
                       > "${prefs}.selftest-new.$$" 2>/dev/null &&
                   mv -f -- "${prefs}.selftest-new.$$" "$prefs" 2>/dev/null; then
                    ok "model.json survives write(tmp)+rename() (favourites persist)"
                else
                    bad "model.json cannot be replaced by rename() (EBUSY?)"
                    note "opencode would swallow this and the favourite would not stick"
                fi
                prefs_restore
                trap - EXIT INT TERM HUP
                [ "$prefs_restore_failed" -eq 0 ] || \
                    bad "could not restore model.json after the write test"
            else
                printf '  %s[ n/a ]%s  could not back up model.json; rename test skipped\n' "$DIM" "$OFF"
            fi
        fi
        # Recents and favourites must be readable as JSON, not just present: a
        # truncated or half-written file is the failure mode of an interrupted
        # copy, and opencode reads this file with a lenient parser that turns
        # anything unrecognised into an empty list -- so a corrupt file shows up
        # as "my favourites vanished" rather than as an error.
        if python3 -c "
import json,sys
d=json.load(open(sys.argv[1]))
assert isinstance(d.get('recent',[]),list) and isinstance(d.get('favorite',[]),list) and isinstance(d.get('variant',{}),dict)
" "$prefs" 2>/dev/null; then
            ok "model.json parses and has the expected shape"
        else
            bad "model.json is not valid JSON with the expected shape"
            note "an interrupted write leaves a file opencode silently reads as empty"
        fi
    fi
fi

# ---------------------------------------------------------------- toolchains
# Slow (downloads packages) but the most honest functionality test there is:
# a read-only package cache looks fine until you try to install into it.
if [ "$WHICH" = all ] || [ "$WHICH" = toolchains ]; then
    section "TOOLCHAIN WRITES (each must land in the sandbox, not the host)"

    printf '    %sBUN_INSTALL_CACHE_DIR=%s\n' "$DIM" "${BUN_INSTALL_CACHE_DIR:-<unset>}"
    printf '    %snpm_config_cache=%s\n'       "$DIM" "${npm_config_cache:-<unset>}"
    printf '    %sUV_CACHE_DIR=%s\n'           "$DIM" "${UV_CACHE_DIR:-<unset>}"
    printf '    %sPIP_CACHE_DIR=%s\n'          "$DIM" "${PIP_CACHE_DIR:-<unset>}"

    W=/tmp/.selftest-pkgs; rm -rf "$W"; mkdir -p "$W"
    run "npm install + require" - bash -c "cd '$W' && npm install --silent --no-audit --no-fund is-odd >/dev/null && node -e \"require('is-odd')\""
    run "bun add + import"     - bash -c "cd '$W' && bun add --silent left-pad >/dev/null && bun -e \"import p from 'left-pad'; p('x',2)\""
    run "uvx runs a package"   - bash -c "uvx --quiet cowsay -t moo >/dev/null"
    run "uv tool install"      - bash -c "uv tool install --quiet ruff >/dev/null && '${UV_TOOL_BIN_DIR:-/nonexistent}/ruff' --version"
    run "pip in a venv"        - bash -c "cd '$W' && python3 -m venv v >/dev/null && ./v/bin/pip install -q requests >/dev/null && ./v/bin/python -c 'import requests'"
    rm -rf "$W"

    # The read-only toolchain dirs must stay read-only. Enumerate whatever is
    # installed rather than naming tools; use test -w so an unprotected
    # toolchain is reported, not corrupted. Executability is covered above.
    checked=0
    for d in "$HOME/.bun" "$HOME/.local/share/uv/tools"; do
        [ -d "$d" ] || continue
        # A few representative files per toolchain, not the whole tree: this is
        # a spot check that the bind is read-only, not an audit of the install.
        for exe in $(find "$d" -type f \( -name '*.js' -o -name '*.py' -o -name '*.sh' \) \
                          2>/dev/null | head -3); do
            checked=$((checked + 1))
            denied "not writable: ${exe/#$HOME/~}" test -w "$exe"
        done
    done
    [ "$checked" -gt 0 ] || note "nothing found in the read-only toolchain dirs; skipped"
fi

# ----------------------------------------------------------------- security
if [ "$WHICH" = all ] || [ "$WHICH" = security ]; then
    section "HOST IPC SOCKETS (a connectable socket = a door)"
    sock "systemd user manager"     "${XDG_RUNTIME_DIR:-/nonexistent}/systemd/private" "${XDG_RUNTIME_DIR:-/nonexistent}/bus"
    sock "D-Bus system bus"         /run/dbus/system_bus_socket
    sock "KDE Wallet"               "${XDG_RUNTIME_DIR:-/nonexistent}/kwallet5.socket"
    sock "Wayland compositor"       "${XDG_RUNTIME_DIR:-/nonexistent}/wayland-0"
    sock "PulseAudio"               "${XDG_RUNTIME_DIR:-/nonexistent}/pulse/native"
    sock "PipeWire"                 "${XDG_RUNTIME_DIR:-/nonexistent}/pipewire-0" "${XDG_RUNTIME_DIR:-/nonexistent}/pipewire-0-manager"
    sock "accessibility bus (a11y)" "${XDG_RUNTIME_DIR:-/nonexistent}/at-spi/bus_0"
    sock "PKCS#11 / smartcards"     "${XDG_RUNTIME_DIR:-/nonexistent}/p11-kit/pkcs11"
    sock "gpg-agent (SSH keys)"     "${XDG_RUNTIME_DIR:-/nonexistent}/gnupg/S.gpg-agent.ssh" "${XDG_RUNTIME_DIR:-/nonexistent}/gnupg/S.gpg-agent"
    sock "systemd journal"          /run/systemd/journal/socket
    sock "xdg document portal"      "${XDG_RUNTIME_DIR:-/nonexistent}/doc"

    # Anything I did not think to list still counts.
    extra=0
    while read -r p; do
        [ -n "${seen[$p]:-}" ] && continue
        seen["$p"]=1
        if try_connect "$p"; then
            extra=$((extra+1)); printf '    %sUNLISTED: %s%s\n' "$RED" "$p" "$OFF"
        fi
    done < <(find "${XDG_RUNTIME_DIR:-/nonexistent}" /run/dbus /run/systemd -maxdepth 3 -type s 2>/dev/null)
    [ "$extra" -eq 0 ] && closed "no unlisted socket is connectable"
    fails=$((fails+extra))

    section "ESCAPE MECHANISMS  (all of these must be denied)"
    run  "systemd-run --user spawns on the HOST" 'Running as unit' systemd-run --user --wait /bin/true
    denied "nsenter into a host namespace"     nsenter -t 1 -m -u -i -n -p /bin/true
    denied "machinectl shell"                  machinectl shell /bin/true
    denied "nested user namespace"             unshare -Ur true
    denied "nested bwrap"                      bwrap --ro-bind / / true
    denied "read host kernel log"              dmesg
    denied "write to /proc/sys"                sh -c 'echo 1 > /proc/sys/kernel/core_pattern'
    denied "load a kernel module"              modprobe tun
    denied "mount anything new"                sh -c 'mount -t tmpfs none /mnt'
    denied "ptrace another process"           timeout 5 gdb -batch -p 1
    denied "read another process's memory"   python3 -c "
import ctypes
libc=ctypes.CDLL('libc.so.6',use_errno=True)
buf=ctypes.create_string_buffer(16)
class IOV(ctypes.Structure):
    _fields_=[('base',ctypes.c_void_p),('len',ctypes.c_size_t)]
l=IOV(ctypes.cast(buf,ctypes.c_void_p),16); r=IOV()
n=libc.process_vm_readv(1,ctypes.byref(l),1,ctypes.byref(r),1,0)
print('bytes',n,'errno',ctypes.get_errno())
raise SystemExit(0 if n==16 else 1)"

    section "HOST FILES (host content must not leak in)"
    # A 0-byte mask is openable but empty, so "can I read bytes" is the test,
    # not "does open() succeed". Non-empty here = host content leaked.
    for f in "$HOME/.local/state/opencode/service.json" \
             "$HOME/.config/opencode/service.json" \
             "$HOME/.local/share/opencode/auth.json" \
             "$HOME/.local/share/opencode/mcp-auth.json" \
             "$HOME/.local/share/opencode/account.json" \
             "$HOME/.local/share/opencode/opencode.db" \
             "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_rsa" "$HOME/.ssh/config"; do
        if [ ! -e "$f" ]; then
            # A masked dir is a tmpfs, so a missing file means hidden; an empty
            # non-tmpfs dir means the host really has no such file.
            dir="$(dirname "$f")"
            if [ -d "$dir" ] && { [ "$(stat -f -c %T "$dir" 2>/dev/null)" = tmpfs ] ||
                                    [ -z "$(ls -A "$dir" 2>/dev/null)" ]; }; then
                closed "hidden (dir masked)  $f"
            else
                printf '  %s[ n/a ]%s  %s (not on host)\n' "$DIM" "$OFF" "$f"
            fi
        elif [ ! -r "$f" ]; then
            closed "unreadable    $f"
        elif [ ! -s "$f" ]; then
            closed "empty mask   $f"
        else
            open_ "READABLE     $f  ($(stat -c %s "$f") bytes)"
        fi
    done

    # The per-repo copy is the one that must be readable and non-empty.
    # $XDG_DATA_HOME is defaulted once here rather than at each expansion: these
    # are bare $VAR expansions under `set -u`, so an unset one aborts the report
    # instead of printing a finding.
    dh="${XDG_DATA_HOME:-/nonexistent}"
    for f in auth.json; do
        if [ -s "$dh/opencode/$f" ]; then
            ok "seeded per-repo copy: $dh/opencode/$f ($(stat -c %s "$dh/opencode/$f") bytes)"
        else
            bad "no usable per-repo copy of $f in $dh/opencode/"
        fi
    done

    # v2 keeps provider keys in the per-repo DB, not the legacy file, so the
    # assertion is that the DB has the rows; the host DB is asserted absent
    # above. No host credentials or no sqlite3 means n/a, not FAIL.
    db="$dh/opencode/opencode.db"
    if ! command -v sqlite3 >/dev/null 2>&1; then
        printf '  %s[ n/a ]%s  sqlite3 not installed; credential rows unverified\n' "$DIM" "$OFF"
    elif [ ! -s "$dh/opencode/auth.json" ]; then
        printf '  %s[ n/a ]%s  no host credentials to copy\n' "$DIM" "$OFF"
    elif [ ! -f "$db" ]; then
        # Test -f before querying: sqlite3 would *create* a missing database,
        # and a check must not write to the store it is checking.
        bad "no opencode.db in $dh/opencode/ to hold credentials"
    else
        rows="$(sqlite3 -cmd '.timeout 2000' "$db" 'SELECT COUNT(*) FROM credential' 2>/dev/null)" || rows=""
        case "$rows" in
            ''|*[!0-9]*)
                bad "no credential table in $db (bootstrap did not run?)"
                ;;
            0)
                bad "credential rows missing from $db (providers will 401)"
                ;;
            *)
                ok "seeded provider credentials: $rows row(s) in data/opencode/opencode.db"
                ;;
        esac
    fi

    # The host's state directory is a tmpfs; the sandbox's model.json is the
    # shared copy at the sandbox path, not this one.
    if [ -e "$HOME/.local/state/opencode/model.json" ]; then
        open_ "READABLE     $HOME/.local/state/opencode/model.json  ($(stat -c %s "$HOME/.local/state/opencode/model.json") bytes)"
    else
        closed "hidden (dir masked)  $HOME/.local/state/opencode/model.json"
    fi
    # The host config is deliberately readable (dotfiles symlinks must resolve)
    # but not writable; content is not asserted.
    if [ -e "$HOME/.config/opencode/cli.json" ]; then
        denied "not writable: ~/.config/opencode/cli.json" test -w "$HOME/.config/opencode/cli.json"
    else
        printf '  %s[ n/a ]%s  ~/.config/opencode/cli.json (not on host)\n' "$DIM" "$OFF"
    fi

    # Home is read-only by default; the opt-in makes it writable. The host's
    # caches stay read-only either way.
    section "WORKING DIRECTORY AND HOME (what the sandbox may write)"
    if cwd_is_home_or_above; then
        if [ "${OPENCODE_SANDBOX_HOME_RW:-0}" = 1 ]; then
            run "working dir is HOME or above it: writable, by opt-in" - touch ./.selftest-probe
            rm -f ./.selftest-probe 2>/dev/null
        else
            denied "working dir is HOME or above it: read-only" touch ./.selftest-probe
        fi
    else
        printf '  %s[ n/a ]%s  working dir is neither HOME nor a parent of it; subdirectories are writable\n' "$DIM" "$OFF"
    fi
    for d in "$HOME/.cache" "$HOME/.config/opencode"; do
        if [ -d "$d" ]; then
            denied "not writable: ${d/#$HOME/~}" test -w "$d"
        else
            printf '  %s[ n/a ]%s  %s (not on host)\n' "$DIM" "$OFF" "${d/#$HOME/~}"
        fi
    done

    # Cross-repo isolation: per-repo data holds credential copies, so a
    # sibling's directory must not be visible. opencode's config/state are
    # shared on purpose; the credentials and session DB are not.
    section "CROSS-REPO ISOLATION (another repo's data is not reachable)"
    sbx_root="$SBX_ROOT"
    root="$(dirname "${sbx_root}")"
    # Positive half first, so the negative checks cannot pass on a bad mount.
    if [ -w "${sbx_root}/data" ] && [ -w "${sbx_root}/state" ]; then
        closed "this repo's data and the shared opencode state are present and writable"
        note "${sbx_root}"
    else
        open_ "this repo's data is missing or read-only"
        note "${sbx_root} -- if the mask went too far, sessions or state are gone"
    fi
    # Then every *other* directory in the state root. A sibling's directory is
    # a finding whether it is readable or not: the credential inside it is what
    # matters, not what can be written to it. The wrapper's `meta` marker is not
    # used to identify a sibling, because the point of the mask is that this
    # repo's own directory no longer carries a readable `meta` either.
    others=""
    for sib in "$root"/*/; do
        [ -d "$sib" ] || continue
        [ "${sib%/}" = "${sbx_root}" ] && continue
        others="${others:+${others}, }$(basename "${sib%/}")"
    done
    if [ -n "$others" ]; then
        open_ "another repo's state directory is visible: ${others}"
        note "its data/opencode/auth.json is a credential copy of that repo's account"
    else
        closed "no other repo's state directory is visible in the state root"
        note "${root}"
    fi
    # The shared opencode state and config live under the same masked root. They
    # are bound at the sandbox's own state/config paths, never at their host
    # paths, so the deliberate sharing cannot be used to enumerate the others.
    if [ -e "${root}/shared" ]; then
        if [ -w "${root}/shared" ]; then
            open_ "the shared sandbox state is writable at its own path: ${root}/shared"
        else
            closed "the shared sandbox state is visible but not writable"
        fi
    else
        closed "the shared sandbox state root is masked; its contents are bound at the sandbox paths"
    fi

    section "SANDBOX IDENTITY"
    printf '    uid=%s  pid1=%s  hostname=%s\n' "$(id -u)" "$(cat /proc/1/comm 2>/dev/null)" "$(hostname 2>/dev/null)"
    printf '    XDG_DATA_HOME=%s\n'  "${XDG_DATA_HOME:-<unset>}"
    printf '    XDG_STATE_HOME=%s\n' "${XDG_STATE_HOME:-<unset>}"
    printf '    XDG_CACHE_HOME=%s\n' "${XDG_CACHE_HOME:-<unset>}"
    printf '    OPENCODE_CONFIG_DIR=%s\n' "${OPENCODE_CONFIG_DIR:-<unset>}"
    printf '    host sockets in %s: %s\n' "${XDG_RUNTIME_DIR:-/nonexistent}" \
        "$(find "${XDG_RUNTIME_DIR:-/nonexistent}" -maxdepth 2 -type s 2>/dev/null | wc -l)"
fi

printf '\n'
if [ "$fails" -eq 0 ]; then
    printf '%s✓ no open escape channels%s\n' "$GREEN" "$OFF"
else
    printf '%s✗ %d open item(s)%s\n' "$RED" "$fails" "$OFF"
fi
exit $(( fails > 0 ))
