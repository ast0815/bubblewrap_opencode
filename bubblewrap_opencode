#!/usr/bin/env bash

set -eo pipefail

TARGET_EXECUTABLE="$(command -v opencode || true)"

if [ -z "${TARGET_EXECUTABLE}" ] || [ ! -x "${TARGET_EXECUTABLE}" ]; then
    echo "bubblewrap_opencode: could not find an opencode executable on PATH" >&2
    exit 1
fi

# Save current-folder as that will be mapped in as read-write and the current folder we execute in.
CURRENT_FOLDER=${PWD}

# Resolve the real binary path (follows alternatives, flatpak, etc.)
REAL_COMMAND="$(readlink -f "$TARGET_EXECUTABLE")"

# Answer --help before any state exists: it needs no bwrap and works on a host
# where the sandbox cannot start. Only the first argument counts, so
# `models --help` is delegated to opencode unchanged.
case "${1:-}" in
    -h|--help)
        cat <<'EOF'
bubblewrap_opencode - runs opencode inside a bubblewrap sandbox.

The filesystem is read-only except the current directory and the sandbox's own
state; ~/.ssh, the host's opencode data and every other repo's data are not
visible. opencode's config and state are shared by every sandbox in this state
root, and are never the host's copies. Network access is shared with the host.

The current directory is the one writable host path. Running from / is refused.
A current directory that is your home directory, or a parent of it such as /home,
is read-only unless OPENCODE_SANDBOX_HOME_RW=1 is set. Subdirectories of home
are writable as usual.

Environment variables, all optional and read before the sandbox starts:

  OPENCODE_SANDBOX_SSH=1          forward the SSH agent socket only, no key material
  OPENCODE_SANDBOX_GH_TOKEN=1     pass the gh CLI's token in as GH_TOKEN, resolved on the host
  OPENCODE_SANDBOX_EXEC=1         run the arguments of the wrapper in the sandbox instead of opencode
  OPENCODE_SANDBOX_HOME=<dir>     where sandbox state lives: writable, and not under /tmp
  OPENCODE_SANDBOX_HOME_RW=1      make a current directory that is $HOME, or a parent of it, writable
  OPENCODE_SANDBOX_RESET=1        delete this repo's data, caches and tools and the shared
                                  opencode config, then re-seed them; the shared state is kept
  OPENCODE_SANDBOX_SYNC_PREFS=1   re-read the host's model.json into the shared opencode state

EOF
        exec "${REAL_COMMAND}" "$@"
        ;;
esac

# Defaults must be exported as well as used: opencode and the tools resolve
# these from the environment.
: "${HOME:=/home/$(id -un)}"
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
: "${XDG_CACHE_HOME:=${HOME}/.cache}"
export XDG_CACHE_HOME
XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR%/}"
export XDG_RUNTIME_DIR

# --- What the sandbox may write -----------------------------------------------
# The current directory is the one writable host path. / is refused (a writable
# root exposes the host control plane); $HOME or a parent of it is read-only
# unless asked otherwise, because it holds what the host runs later (shell
# startup files, dotfiles, hooks). Subdirectories of home are writable.
CWD_REAL="$(readlink -f -- "${CURRENT_FOLDER}" 2>/dev/null || printf '%s' "${CURRENT_FOLDER}")"
HOME_REAL="$(readlink -f -- "${HOME}" 2>/dev/null || printf '%s' "${HOME}")"
if [ "${CWD_REAL}" = "/" ]; then
    echo "bubblewrap_opencode: refusing to run with / as the working directory; cd into a project first" >&2
    exit 1
fi
cwd_is_home_or_above=0
case "${HOME_REAL}/" in
    "${CWD_REAL%/}/"*) cwd_is_home_or_above=1 ;;
esac

# --- Persistent state: one shared opencode home, per-repo data --------------
# shared/ holds opencode's config and runtime state for every sandbox. These
# describe the person and the tool, not the repository; binding a *directory*
# (not model.json as a file) is also what makes opencode's write(tmp)+rename()
# work. <repo>-<hash>/ holds the parts worth keeping apart: the session DB and
# credential copies, opencode's cache, and the package-manager caches/tools.
# Both live outside the repo so git clean cannot destroy session history.
SBX_ROOT="$(git -C "${CURRENT_FOLDER}" rev-parse --show-toplevel 2>/dev/null || printf '%s' "${CURRENT_FOLDER}")"
SBX_KEY="$(basename "${SBX_ROOT}")-$(printf '%s' "${SBX_ROOT}" | sha256sum | cut -c1-12)"

# Prefer a persistent base under home; fall back if it is read-only. No /tmp
# fallback: /tmp is a tmpfs inside the sandbox, so state there would be masked.
SBX=""
for base in "${OPENCODE_SANDBOX_HOME:-${HOME}/.local/share/opencode-sbx}" \
            "${XDG_CACHE_HOME}/opencode-sbx"; do
    # mkdir -p is not a writability test; the empty redirect is.
    if mkdir -p "${base}/${SBX_KEY}/data/opencode" "${base}/shared/state" 2>/dev/null &&
       ( : > "${base}/${SBX_KEY}/.writable" ) 2>/dev/null; then
        rm -f -- "${base}/${SBX_KEY}/.writable"
        SBX="${base}/${SBX_KEY}"
        SBX_PARENT="${base}"
        [ "${base}" = "${OPENCODE_SANDBOX_HOME:-${HOME}/.local/share/opencode-sbx}" ] || \
            echo "bubblewrap_opencode: home is not writable, using ${SBX}" >&2
        break
    fi
done
if [ -z "${SBX}" ]; then
    echo "bubblewrap_opencode: no writable location for sandbox state." >&2
    echo "bubblewrap_opencode: set OPENCODE_SANDBOX_HOME to a directory that is writable and not under /tmp." >&2
    exit 1
fi

# opencode's own config and state, shared by every repo in this state root.
SHARED="${SBX_PARENT}/shared"
SHARED_CONFIG="${SHARED}/config/opencode"
SHARED_STATE="${SHARED}/state/opencode"

# Drop this repo's data/cache/tools and the shared config, then re-seed the
# config. Keep the shared state: favourites/history are not per-repo data.
# `rm -rf <state root>/shared` is the full wipe.
if [ "${OPENCODE_SANDBOX_RESET:-0}" = "1" ]; then
    echo "bubblewrap_opencode: resetting this repo's data and the shared config in ${SBX_PARENT}" >&2
    rm -rf -- "${SBX}/data" "${SBX}/cache" "${SBX}/tools" "${SHARED}/config"
fi
mkdir -p "${SBX}/data/opencode" "${SBX}/state/opencode" "${SBX}/config/opencode" \
         "${SBX}/cache/bun" "${SBX}/cache/npm" "${SBX}/cache/uv" \
         "${SBX}/cache/pip" "${SBX}/tools/bin" \
         "${SHARED}/config" "${SHARED_STATE}"
# An older version seeded a per-repo config copy. It is not bound any more, but
# it is the fallback if the shared bind fails; leave no host password in it.
rm -f -- "${SBX}/config/opencode/service.json" 2>/dev/null
printf '%s\n' "${SBX_ROOT}" > "${SBX}/meta"

# Removed: a single-file bind broke rename(). Warn rather than silently ignore.
if [ "${OPENCODE_SANDBOX_HOST_PREFS:-0}" = "1" ]; then
    echo "bubblewrap_opencode: OPENCODE_SANDBOX_HOST_PREFS is no longer supported; sandbox state is shared across repos and kept separate from the host (use OPENCODE_SANDBOX_SYNC_PREFS=1 to pull the host's favourites)" >&2
fi

# Per-repo package caches: the host toolchains stay read-only, so nothing a
# sandboxed agent downloads can be executed by a later unsandboxed session.
export BUN_INSTALL_CACHE_DIR="${SBX}/cache/bun"
export BUN_TMPDIR=/tmp
export npm_config_cache="${SBX}/cache/npm"
export UV_CACHE_DIR="${SBX}/cache/uv"
export UV_TOOL_DIR="${SBX}/tools"
# uv also symlinks each tool's executable into ~/.local/bin, which is read-only
# here, so that needs redirecting too.
export UV_TOOL_BIN_DIR="${SBX}/tools/bin"
export PIP_CACHE_DIR="${SBX}/cache/pip"

# --- SSH: agent forwarding only, and only when asked -------------------------
# No key material; the agent does the signing on the host. Without the opt-in,
# git-over-SSH simply fails to authenticate. The socket is bound *after* the
# ~/.ssh tmpfs so it survives the mask.
ssh_args=()
if [ "${OPENCODE_SANDBOX_SSH:-0}" = "1" ]; then
    if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "${SSH_AUTH_SOCK}" ]; then
        # Same path as the host, so SSH_AUTH_SOCK needs no rewriting. --dir
        # recreates the parent after the state root became a tmpfs; the file
        # itself is the persistent per-repo known_hosts.
        mkdir -p "${SBX}/ssh"
        ssh_args=(--dir "$(dirname "${SSH_AUTH_SOCK}")"
                  --dir "${SBX}/ssh"
                  --bind "${SSH_AUTH_SOCK}" "${SSH_AUTH_SOCK}")
        if [ ! -s "${SBX}/ssh/known_hosts" ] && [ -r "${HOME}/.ssh/known_hosts" ]; then
            # Public host keys only; lets git clone verify hosts without an
            # interactive prompt, and new hosts are accepted per repo.
            cp -f -- "${HOME}/.ssh/known_hosts" "${SBX}/ssh/known_hosts"
        fi
        [ -s "${SBX}/ssh/known_hosts" ] && ssh_args+=(--bind "${SBX}/ssh/known_hosts" "${SBX}/ssh/known_hosts")
        export SSH_KNOWN_HOSTS="${SBX}/ssh/known_hosts"
        export GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=${SSH_KNOWN_HOSTS}"
    else
        echo "bubblewrap_opencode: OPENCODE_SANDBOX_SSH=1 but SSH_AUTH_SOCK is not a live socket; continuing without SSH" >&2
    fi
fi

# --- GitHub: the gh CLI's token, when asked -----------------------------------
# The token is resolved here, on the host: the keyring sockets are masked
# inside. It travels in the environment, not a file. This is a large give-away;
# see DESIGN.md. The wrapper never runs `gh auth login`.
if [ "${OPENCODE_SANDBOX_GH_TOKEN:-0}" = "1" ]; then
    if command -v gh >/dev/null 2>&1 && token="$(gh auth token 2>/dev/null)" && [ -n "$token" ]; then
        export GH_TOKEN="$token"
    else
        echo "bubblewrap_opencode: OPENCODE_SANDBOX_GH_TOKEN=1 but gh is missing or not logged in on the host; continuing without GitHub" >&2
    fi
fi
unset token

export XDG_DATA_HOME="${SBX}/data"    # per-repo DB, logs, snapshots
# The state directory is a mount point for the shared copy; model.json is a
# real file there, so opencode's temp+rename works.
export XDG_STATE_HOME="${SBX}/state"

# --- XDG_CACHE_HOME: per repo, seeded once from the host cache ----------------
# The host's ~/.cache/opencode must stay read-only: opencode downloads and
# executes provider packages there. Each repo gets a seeded copy instead.
# Reflink makes it cheap; without it seed_copy says so.
CACHE_SEED="${XDG_CACHE_HOME}/opencode"
export XDG_CACHE_HOME="${SBX}/cache/home"
mkdir -p "${XDG_CACHE_HOME}"

# Copy a host directory once, atomically. The host original stays read-only; a
# failed copy warns and continues. A ".<name>-seeded" marker written last is
# what says the copy finished.
#
#   $1  source directory; absent means nothing to do
#   $2  destination path itself, not its parent
seed_copy() {
    local src=$1 dst=$2 dir name reflink probe broken
    dir="$(dirname "$dst")"
    name="$(basename "$dst")"
    if [ ! -d "$src" ] || [ -e "${dir}/.${name}-seeded" ]; then
        return 0
    fi
    # Probe reflink support on the destination filesystem without touching the
    # source: a copy within one directory clones if the filesystem can.
    probe="${dir}/.reflink-probe"
    if dd if=/dev/urandom of="${probe}" bs=64K count=1 2>/dev/null &&
       cp --reflink=always -- "${probe}" "${probe}.clone" 2>/dev/null; then
        reflink=(--reflink=always)
    else
        reflink=()
        echo "bubblewrap_opencode: no reflink support on ${dir}; seeding ${name} is a full copy" >&2
    fi
    rm -f -- "${probe}" "${probe}.clone"

    # Temporary name + move: an interrupted seed must not leave a directory the
    # marker then vouches for.
    rm -rf -- "${dst}.partial"
    if cp -a "${reflink[@]+"${reflink[@]}"}" -- "${src}" "${dst}.partial" 2>/dev/null &&
       mv -T -- "${dst}.partial" "${dst}" 2>/dev/null; then
        : > "${dir}/.${name}-seeded"
    else
        rm -rf -- "${dst}.partial"
        echo "bubblewrap_opencode: could not seed ${name} from ${src}; continuing without it" >&2
        return 0
    fi

    # A dangling symlink here is a silent failure: opencode starts with no
    # providers/MCP/keybinds and says nothing. Name the offenders.
    broken="$(find "${dst}" -xtype l -print 2>/dev/null | head -5 || true)"
    if [ -n "$broken" ]; then
        echo "bubblewrap_opencode: symlinks in ${dst} do not resolve:" >&2
        printf '  %s\n' "$broken" >&2
    fi
    return 0
}

seed_copy "${CACHE_SEED}" "${XDG_CACHE_HOME}/opencode"

# --- opencode's config dir: one copy, shared by every repo --------------------
# The host's ~/.config/opencode must stay read-only (cli.json is written, and
# plugins install dependencies there). The sandbox gets one seeded copy, shared
# by every repo. OPENCODE_CONFIG_DIR, not XDG_CONFIG_HOME: moving the latter
# would also relocate git/gh config. Plain files are a seed-time snapshot;
# symlinks stay live. RESET=1 re-seeds. The copy is stripped of service.json.
HOST_CONFIG="${XDG_CONFIG_HOME:-${HOME}/.config}/opencode"
export OPENCODE_CONFIG_DIR="${SBX}/config/opencode"
seed_copy "${HOST_CONFIG}" "${SHARED_CONFIG}"
# The config copy is readable from inside. Strip the host's service password if
# the host config carries one; it is host state, not configuration. Do it after
# the seed on every run, so an older copy that already has it is cleaned too.
rm -f -- "${SHARED_CONFIG}/service.json" 2>/dev/null

# --- Credentials -------------------------------------------------------------
# The host-wide server's service.json must not be readable here, and the v1
# auth files are copied into this repo's own data dir before the host originals
# are masked.
HOST_DATA="${HOME}/.local/share/opencode"
HOST_STATE="${HOME}/.local/state/opencode"

# Empty tmpfs masks. Each target must exist before bwrap starts. The runtime
# directory is masked twice because XDG_RUNTIME_DIR can be stale. ${SBX_PARENT}
# is masked wholesale: under --ro-bind / / it held sibling repos' auth.json. The
# binds later put this repo's directories and the shared copies back; bwrap
# resolves sources on the host, so that ordering is safe.
hide_dirs=()
skipped_dirs=()
hidden_paths=" "
for d in "${XDG_RUNTIME_DIR}" "/run/user/$(id -u)" /run/dbus /run/systemd \
         "${HOST_DATA}" "${HOST_STATE}" "${HOME}/.ssh" "${SBX_PARENT}"; do
    [ -n "$d" ] || continue
    case "${hidden_paths}" in *" ${d} "*) continue ;; esac
    if [ -d "$d" ] || mkdir -p "$d" 2>/dev/null; then
        hide_dirs+=(--tmpfs "$d")
        hidden_paths+="${d} "
    else
        echo "bubblewrap_opencode: $d is absent and cannot be created; it stays visible read-only" >&2
        skipped_dirs+=("$d")
    fi
done

# Hide a path behind a 0-byte read-only file: reads see nothing, writes fail,
# the host copy is untouched. bwrap consumes each fd it is given, so every mask
# needs its own descriptor.
mask_args=()
add_mask() {
    local p=$1 fd parent s
    parent="$(dirname "$p")"
    for s in ${skipped_dirs[@]+"${skipped_dirs[@]}"}; do
        [ "$parent" = "$s" ] && return 0
    done
    exec {fd}</dev/null
    mask_args+=(--ro-bind-data "$fd" "$p")
}
add_mask "${HOST_STATE}/service.json"
# The host's *config* directory is deliberately readable, but it can carry a
# stale service.json with the same host-wide server password. Mask that one file
# so "the config is readable" does not also mean "the host service is reachable
# with a password read from the sandbox". The seeded copy is stripped too.
# Guarded on the directory: a host with no opencode config has nothing to mask,
# and --ro-bind-data cannot create the parent on its own.
if [ -d "${HOST_CONFIG}" ]; then
    add_mask "${HOST_CONFIG}/service.json"
fi
for f in auth.json mcp-auth.json account.json; do
    add_mask "${HOST_DATA}/${f}"
    [ -r "${HOST_DATA}/${f}" ] || continue
    # Seed once. Afterwards the copy is an ordinary writable file, so an OAuth
    # refresh mid-session persists instead of being thrown away at exit.
    if [ ! -s "${SBX}/data/opencode/${f}" ]; then
        cp -f -- "${HOST_DATA}/${f}" "${SBX}/data/opencode/${f}"
        chmod 600 -- "${SBX}/data/opencode/${f}"
    fi
done

# --- Provider credentials: the rows opencode v2 reads --------------------------
# v2 keeps provider keys in the credential table of its own DB and does not
# reliably import them from auth.json (measured on v2.0.11). Copy only those
# rows, from the host DB attached read-only; the host's history stays behind.
# An empty store means "not seeded", so RESET=1 re-seeds. The schema is
# bootstrapped by opencode itself once, with a blank config and --standalone.
OPENCODE_VERSION="$("$REAL_COMMAND" --version 2>/dev/null || true)"
case "$OPENCODE_VERSION" in
    *v[2-9].*) want_standalone=1 ;;
    *)         want_standalone=0 ;;
esac
HOST_DB="${HOST_DATA}/opencode.db"
REPO_DB="${SBX}/data/opencode/opencode.db"
if [ "${want_standalone}" = 1 ]; then
    if ! command -v sqlite3 >/dev/null 2>&1; then
        echo "bubblewrap_opencode: sqlite3 not found; provider credentials are not seeded into this repo" >&2
    elif [ -r "${HOST_DB}" ]; then
        # A fresh DB has no credential table, and a hand-made one is rejected by
        # opencode's migrations. Bootstrap the schema once, blank config.
        cred_rows() {
            [ -f "${REPO_DB}" ] || return 1
            sqlite3 -cmd '.timeout 2000' "${REPO_DB}" \
                'SELECT COUNT(*) FROM credential' 2>/dev/null
        }
        if ! cred_rows >/dev/null 2>&1; then
            if command -v timeout >/dev/null 2>&1 && tmp_cfg="$(mktemp -d 2>/dev/null)"; then
                OPENCODE_CONFIG_DIR="${tmp_cfg}" timeout 60 "${REAL_COMMAND}" \
                    session list --standalone </dev/null >/dev/null 2>&1 || true
                rm -rf -- "${tmp_cfg}"
            fi
        fi
        rows="$(cred_rows)" || rows=""
        case "${rows}" in
            0)
                # mode=ro makes the host DB unwritable; INSERT OR IGNORE makes a
                # second seed a no-op. Quotes in the path are doubled for ATTACH.
                if ! sqlite3 -cmd '.timeout 2000' "${REPO_DB}" \
                    "ATTACH DATABASE 'file:${HOST_DB//\'/\'\'}?mode=ro' AS host;
                     INSERT OR IGNORE INTO credential SELECT * FROM host.credential;
                     DETACH DATABASE host;" 2>/dev/null; then
                    echo "bubblewrap_opencode: could not copy credential rows from ${HOST_DB}" >&2
                fi
                ;;
            "")
                echo "bubblewrap_opencode: no credential table in ${REPO_DB}; provider credentials are not seeded (a later start retries)" >&2
                ;;
            *)
                : # already seeded; an ordinary writable part of this repo's state
                ;;
        esac
    fi
fi

# --- opencode state: one directory, shared by every sandbox -------------------
# opencode writes model.json, prompt history, kv, pins and pty with
# write(tmp)+rename(path). Bind the directory, not model.json: a file bind
# makes that rename fail with EBUSY (toggleFavorite swallows the error).
# Shared by every repo, never the host's. Seed only model.json (old prefs,
# then host, then this repo's old file); prompt history/kv/pins start empty.
# Wart: the lock path still starts with this repo's ${SBX}, so two sandboxes
# do not exclude each other; a concurrent toggle can be lost.
mkdir -p "${SHARED_STATE}" "${SBX}/state/opencode" 2>/dev/null || \
    echo "bubblewrap_opencode: cannot create the shared opencode state in ${SHARED_STATE}" >&2

# OPENCODE_SANDBOX_SYNC_PREFS=1 pulls the host's model.json, one way, for after
# a session with the unsandboxed opencode. Atomic so an interrupted pull cannot
# truncate the shared file.
if [ "${OPENCODE_SANDBOX_SYNC_PREFS:-0}" = "1" ]; then
    if [ -s "${HOST_STATE}/model.json" ]; then
        if cp -f -- "${HOST_STATE}/model.json" "${SHARED_STATE}/model.json.new.$$" 2>/dev/null &&
           mv -f -- "${SHARED_STATE}/model.json.new.$$" "${SHARED_STATE}/model.json" 2>/dev/null; then
            echo "bubblewrap_opencode: preferences re-read from ${HOST_STATE}/model.json" >&2
        else
            rm -f -- "${SHARED_STATE}/model.json.new.$$" 2>/dev/null
            echo "bubblewrap_opencode: could not update ${SHARED_STATE}/model.json; keeping what is there" >&2
        fi
    else
        echo "bubblewrap_opencode: OPENCODE_SANDBOX_SYNC_PREFS=1 but ${HOST_STATE}/model.json is absent or empty; nothing to pull" >&2
    fi
fi

# Seed the shared model.json only if it is absent, so a running sandbox never
# has its favourites overwritten. The old locations are read, never modified.
if [ ! -e "${SHARED_STATE}/model.json" ]; then
    pref_seed=""
    if [ -s "${SBX_PARENT}/prefs/model.json" ]; then
        pref_seed="${SBX_PARENT}/prefs/model.json"
    elif [ -s "${HOST_STATE}/model.json" ]; then
        pref_seed="${HOST_STATE}/model.json"
    elif [ -s "${SBX}/state/opencode/model.json" ]; then
        pref_seed="${SBX}/state/opencode/model.json"
    fi
    if [ -n "$pref_seed" ]; then
        cp -f -- "$pref_seed" "${SHARED_STATE}/model.json.new.$$" 2>/dev/null &&
            mv -f -- "${SHARED_STATE}/model.json.new.$$" "${SHARED_STATE}/model.json" 2>/dev/null ||
            rm -f -- "${SHARED_STATE}/model.json.new.$$" 2>/dev/null
    else
        printf '%s\n' '{"recent":[],"favorite":[],"variant":{}}' > "${SHARED_STATE}/model.json" 2>/dev/null || true
    fi
fi

# seed_copy returns 0 when the host has no config directory, so make sure the
# bind source exists even then: an empty config dir is what this used to be.
[ -d "${SHARED_CONFIG}" ] || mkdir -p "${SHARED_CONFIG}" 2>/dev/null || true

# The binds land on the sandbox's own paths, where opencode looks. bwrap
# resolves sources in the host namespace, so they survive the ${SBX_PARENT}
# tmpfs; the destinations must exist first. A missing source is skipped, so a
# failure degrades to the per-repo directory instead of refusing to start.
shared_args=()
if [ -d "${SHARED_STATE}" ]; then
    shared_args+=(--bind "${SHARED_STATE}" "${SBX}/state/opencode")
else
    echo "bubblewrap_opencode: no ${SHARED_STATE}; opencode state stays per repo" >&2
fi
if [ -d "${SHARED_CONFIG}" ]; then
    shared_args+=(--bind "${SHARED_CONFIG}" "${SBX}/config/opencode")
else
    echo "bubblewrap_opencode: no ${SHARED_CONFIG}; opencode starts without the host config" >&2
fi

# The current directory: read-only if it is $HOME or a parent of it, writable
# otherwise. bwrap applies mounts in order and a later mount hides an earlier one
# beneath it, so this must come before every mask and per-repo bind; /tmp is a
# fresh tmpfs and comes before it, so a current directory under /tmp stays visible.
cwd_args=(--bind "${CURRENT_FOLDER}" "${CURRENT_FOLDER}")
if [ "${cwd_is_home_or_above}" = 1 ]; then
    if [ "${OPENCODE_SANDBOX_HOME_RW:-0}" = "1" ]; then
        echo "bubblewrap_opencode: OPENCODE_SANDBOX_HOME_RW=1: ${CURRENT_FOLDER} is writable, including your dotfiles and anything a later shell runs" >&2
        # Home is writable now, but these two stay read-only, as they are everywhere else.
        cwd_args+=(--ro-bind-try "${HOME}/.cache" "${HOME}/.cache"
                   --ro-bind-try "${HOME}/.config/opencode" "${HOME}/.config/opencode")
    else
        echo "bubblewrap_opencode: ${CURRENT_FOLDER} is your home directory or a parent of it, so it is read-only; set OPENCODE_SANDBOX_HOME_RW=1 to make it writable" >&2
        cwd_args=()
    fi
fi

# Build the full bwrap argument array
bwrap_args=(
    bwrap

    # Drop as many privilieges as possible
    --unshare-all

    # But allow network access
    --share-net

    # A process inside must not be able to build a *second* sandbox. Inside a
    # user namespace, unshare(CLONE_NEWUSER) is otherwise free, which hands a
    # compromised agent a fresh privileged mount namespace to work with.
    # --disable-userns installs a seccomp filter that makes any attempt fail
    # with ENOSPC, and sets no_new_privs. It insists on seeing --unshare-user
    # explicitly, so state it even though --unshare-all already implies it.
    --unshare-user
    --disable-userns

    # Nothing inside needs any capability; several tools also refuse to start
    # when they see an empty bounding set, so this is also a sanity signal.
    --cap-drop ALL

    # A distinctive hostname makes it obvious in ps/top/screenshots that a
    # process is sandboxed rather than a normal one.
    --hostname opencode-sandbox

    # Start a fresh session
    --new-session
    --die-with-parent

    # Mount the whole file system read-only
    --ro-bind   / /

    # A fresh /tmp, then the current directory on top of it (see cwd_args above).
    --tmpfs /tmp
    ${cwd_args[@]+"${cwd_args[@]}"}

    # Cut the host control plane. Each of these is a way for the sandbox to
    # make the *host* act: $XDG_RUNTIME_DIR (systemd --user, wallets, portals,
    # Wayland, audio, gpg), /run/dbus (polkit, flatpak, NetworkManager) and
    # /run/systemd (journal, manager).

    # Hide host opencode data/state and ~/.ssh. The host config stays readable
    # (dotfiles symlinks must resolve); the shared copy bound later is what
    # opencode reads and writes.
    ${hide_dirs[@]+"${hide_dirs[@]}"}

    # 0-byte read-only masks on the credential files, belt and braces.
    ${mask_args[@]+"${mask_args[@]}"}

    # This repo's data/cache/tools and the shared opencode config/state. The
    # per-repo binds restore this repo after the state-root tmpfs above;
    # state/ and config/ are mount points for the shared children. meta is not
    # bound back (wrapper bookkeeping only).
    --bind "${SBX}/data"   "${SBX}/data"
    --bind "${SBX}/state"  "${SBX}/state"
    --bind "${SBX}/cache"  "${SBX}/cache"
    --bind "${SBX}/tools"  "${SBX}/tools"
    --bind "${SBX}/config" "${SBX}/config"
    ${shared_args[@]+"${shared_args[@]}"}

    # Add dev and proc special binds
    --dev /dev
    --proc /proc

    # SSH socket after the ~/.ssh mask, so it survives. No key material.
    ${ssh_args[@]+"${ssh_args[@]}"}

    # Host toolchains are on PATH, so a writable bind here is code execution
    # for a later unsandboxed shell.
    --ro-bind-try "${HOME}/.bun" "${HOME}/.bun"
    --ro-bind-try "${HOME}/.local/share/uv/tools" "${HOME}/.local/share/uv/tools"

    # ~/.cache, including ~/.cache/opencode, stays read-only. No host-writable
    # bind remains; the sandbox gets per-repo copies instead.
)

# Stop advertising the host desktop/secret services we just made unreachable.
unset DBUS_SESSION_BUS_ADDRESS DISPLAY WAYLAND_DISPLAY XAUTHORITY ICEAUTHORITY \
      PAM_KWALLET5_LOGIN XDG_ACTIVATION_TOKEN XDG_CURRENT_DESKTOP \
      XDG_MENU_PREFIX XDG_SEAT XDG_SEAT_PATH XDG_SESSION_CLASS \
      XDG_SESSION_DESKTOP XDG_SESSION_ID XDG_SESSION_PATH \
      XDG_SESSION_TYPE XDG_VTNR

# Escape hatch: run an arbitrary command inside exactly the sandbox opencode
# would get, instead of opencode itself. Used by sandbox-selftest and handy for
# one-off commands. Unset again so it cannot leak into the sandbox.
if [ -n "${OPENCODE_SANDBOX_EXEC:-}" ]; then
    unset OPENCODE_SANDBOX_EXEC
    exec "${bwrap_args[@]}" -- "$@"
fi

# For v2+, use a private server so the host-wide background service is not
# touched and the server runs inside the sandbox.
#
# The flag belongs after the subcommand path and is not accepted everywhere.
# The deny list below is from the v2.1.2 help output: an unknown command gets
# the flag, so re-check it when opencode is upgraded. Only auth/session have a
# subcommand as their second word.
path=()
if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
    path=("$1")
    case "$1" in
        auth|session)
            if [ "$#" -gt 1 ] && [ "${2#-}" = "$2" ]; then
                path+=("$2")
            fi
            ;;
    esac
fi

verdict=yes
case "${path[0]:-}" in
    upgrade|update|uninstall|acp|service|pair|serve|debug|mcp|plugin)
        verdict=no
        ;;
    auth|session)
        if [ "${#path[@]}" -eq 1 ]; then
            verdict=no
        fi
        ;;
esac

opencode_args=("$REAL_COMMAND")
if [ "$want_standalone" = 1 ]; then
    if [ "${#path[@]}" -eq 0 ]; then
        # No subcommand at all: this is the TUI, which does accept the flag.
        opencode_args+=(--standalone)
    else
        opencode_args+=("${path[@]}")
        if [ "$verdict" = yes ]; then
            opencode_args+=(--standalone)
        fi
    fi
fi
# Everything after the subcommand path. ${@:N} is 1-based in bash (and ${@:0}
# is the special "all arguments" case), so dropping len(path) arguments needs
# len(path)+1. The offset is computed in a variable on purpose: a nested
# ${#path[@]} inside the slice is mis-parsed and silently yields the wrong
# arguments.
if [ "${#path[@]}" -gt 0 ]; then
    skip=$((${#path[@]} + 1))
    opencode_args+=("${@:$skip}")
else
    opencode_args+=("$@")
fi

exec "${bwrap_args[@]}" -- "${opencode_args[@]}"
